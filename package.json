{
  "name": "templates.bun",
  "version": "0.1.0",
  "description": "Reusable Bun starter with TypeScript, Prettier, and tests.",
  "type": "module",
  "main": "src/index.ts",
  "module": "src/index.ts",
  "files": [
    "src"
  ],
  "engines": {
    "bun": ">=1.3.0"
  },
  "packageManager": "bun@1.3.14",
  "license": "MIT",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "build": "bun build ./src/index.ts --outdir ./dist --target bun --sourcemap=linked",
    "format": "bun x --no-install prettier --write .",
    "lint": "bun run lint:format && bun run lint:oxlint",
    "lint:format": "bun x --no-install prettier --check . --cache --cache-strategy content --cache-location .cache/prettier/.prettier-cache",
    "lint:oxlint": "bun x --no-install oxlint .",
    "lint:ratchet": "bun tools/lint/ratchet.ts",
    "lint:suppressions": "bun tools/lint/check-suppressions.ts",
    "typecheck": "bun run typecheck:app && bun run typecheck:tools",
    "typecheck:app": "bun x --no-install tsc --noEmit",
    "typecheck:tools": "bun x --no-install tsc -p tsconfig.tools.json --noEmit",
    "check": "bun run lint && bun run typecheck && bun run test",
    "test": "bun test",
    "test:changed": "bun test --changed",
    "test:coverage": "bun test --coverage",
    "test:watch": "bun test --watch"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.79.0",
    "@types/bun": "^1.3.14",
    "oxc-parser": "0.147.0",
    "oxlint": "1.79.0",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2"
  }
}
